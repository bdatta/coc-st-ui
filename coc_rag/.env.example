# Copy to .env and fill in. Never commit the real file.

# --- MongoDB Atlas -------------------------------------------------------
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=coc_rag
MONGODB_COLLECTION=coc_chunks
VECTOR_INDEX_NAME=coc_vector_index
TEXT_INDEX_NAME=coc_text_index

# --- Embeddings ----------------------------------------------------------
# provider: voyage | openai | local
EMBED_PROVIDER=voyage
EMBED_MODEL=voyage-3.5
EMBED_DIM=1024
VOYAGE_API_KEY=
OPENAI_API_KEY=

# --- Answer generation ---------------------------------------------------
# provider: anthropic | openai
ANSWER_PROVIDER=anthropic
ANSWER_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# --- Misc ----------------------------------------------------------------
WORK_DIR=./data

# Only set this if you have pre-downloaded tiktoken's BPE files and want exact
# token counts instead of the built-in estimate.
# TIKTOKEN_CACHE_DIR=/opt/tiktoken_cache
